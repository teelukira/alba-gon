# ========================================================
# [편의점 알바곤] 유앤미24(younme24.com) 자동 발주 계정 설정
# ========================================================
# ※ 주의: 이 파일은 예제 템플릿입니다.
# 실제 비밀번호는 동일한 위치의 '.env' 파일에 입력하세요.
# '.env' 파일은 .gitignore에 등록되어 GitHub에 절대 올라가지 않습니다.

# 1. 유앤미24 거래처 아이디 (과거 엑셀 기준: 11470)
YOUNME_USER_ID=11470

# 2. 유앤미24 실제 로그인 비밀번호 (사장님의 실제 비밀번호를 입력해주세요)
YOUNME_PASSWORD=여기에_실제_비밀번호_입력

# 3. 로컬 봇 서버 포트 (기본값: 3001)
BOT_PORT=3001

# 4. 브라우저 실행 모드 (false: 크롬 창을 눈앞에 띄움, true: 백그라운드 숨김)
HEADLESS=false
